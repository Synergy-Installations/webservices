{
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:ensure-indexes": "node --env-file=apps/frontend/.env.local --import tsx scripts/ensure-montage-indexes.ts",
    "db:concurrency-check": "node --env-file=apps/frontend/.env.local --import tsx scripts/montage-concurrency-check.ts",
    "db:update-rules": "node --env-file=apps/frontend/.env.local --import tsx scripts/update-montage-rules.ts",
    "submit": "bash scripts/submit-for-review.sh",
    "test": "vitest run"
  },
  "devDependencies": {
    "@com.synergy/frontend-backend-dashboard": "workspace:^",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tsx": "^4.22.4",
    "turbo": "^2.9.6",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  },
  "name": "com.synergy",
  "pnpm": {
    "overrides": {
      "@tiptap/core": "2.11.7"
    }
  },
  "dependencies": {
    "@trigger.dev/sdk": "4.4.6",
    "trigger.dev": "^4.4.5"
  }
}