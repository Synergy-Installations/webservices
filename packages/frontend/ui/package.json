{
  "name": "@com.synergy/frontend-ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./MobileMenu": "./src/landingPage/header/MobileMenu.tsx",
    "./DefaultDropdown": "./src/shared/dropdown/DefaultDropdown.tsx",
    "./DefaultHeader": "./src/landingPage/header/DefaultHeader.tsx",
    "./frontendUiStyles.css": "./dist/index.css",
    "./landingPageStyles.css": "./src/landingPage/styles/styles.css",
    "./card": "./src/card.tsx"
  },
  "license": "MIT",
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "lint": "eslint src/",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@com.synergy/frontend-shared-eslint-config": "workspace:*",
    "@com.synergy/frontend-shared-internationalization": "workspace:*",
    "@com.synergy/frontend-shared-tailwind-config": "workspace:*",
    "@com.synergy/frontend-shared-typescript-config": "workspace:*",
    "@turbo/gen": "^2.3.3",
    "@types/react": "^18.2.61",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0"
  }
}
