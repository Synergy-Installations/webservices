{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": [
        "SENDGRID_API_KEY",
        "STORAGE_ZONE_ACCESS_KEY",
        "CLERK_SECRET_KEY",
        "MONGODB_URI",
        "CLERK_WEBHOOK_SIGNING_SECRET",
        "STORAGE_ZONE_REGION",
        "STORAGE_ZONE_BASE_HOSTNAME",
        "STORAGE_ZONE_NAME",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_REQUIRE_TLS",
        "SMTP_TLS_REJECT_UNAUTHORIZED",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "NEXT_PUBLIC_C15T_URL"
      ],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
